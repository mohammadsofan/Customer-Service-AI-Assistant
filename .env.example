# -----------------------------------------------------------------------------
# Customer Service AI Assistant - Environment Configuration
# -----------------------------------------------------------------------------

# --- ASP.NET Core Environment ---
# Controls the runtime environment (Development, Staging, Production).
# In Production, Swagger is disabled and error traces are hidden.
ASPNETCORE_ENVIRONMENT=Production

# --- Database ---
# The SA password for the SQL Server Docker container.
# Must be at least 8 characters long and contain characters from three of the following four sets: 
# Uppercase letters, Lowercase letters, Base 10 digits, and Symbols.
DB_PASSWORD=ChangeThisToAStrongPassword123!

# --- JWT Authentication ---
# The secret key used to sign JSON Web Tokens. Must be at least 32 characters long.
JWT_SECRET=YourSuperSecretKeyThatIsAtLeastThirtyTwoCharactersLong!
# The token issuer (usually your domain or app name).
JWT_ISSUER=AIEmployeeSupport
# The intended audience for the token.
JWT_AUDIENCE=AIEmployeeSupportClient

# --- Encryption ---
# The AES-256 key used to encrypt AI Provider API Keys at rest in the database.
# Must be exactly 32 bytes (64 hex characters or a 32-character string).
ENCRYPTION_KEY=Your32CharacterLengthSecretKey!!

# --- CORS & Networking ---
# The allowed origin for the frontend client (e.g., your production domain).
CORS_ORIGIN=http://localhost:3000
